// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  EMPLOYER
  ADMIN
  SUPER_ADMIN
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
}

enum CompanyMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
  REMOVED
  CANCELLED
}

enum CompanyStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CompanyVisibility {
  PUBLIC
  PRIVATE
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ExperienceLevel {
  FRESHER
  INTERN
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  ARCHITECT
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  FILLED
  EXPIRED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
  TEMPORARY
  APPRENTICESHIP
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum JobVisibility {
  PUBLIC
  PRIVATE
  INTERNAL
}

enum SalaryPeriod {
  HOURLY
  MONTHLY
  YEARLY
}

enum GradingSystem {
  PERCENTAGE
  CGPA
  GPA_4
  GPA_5
  GPA_10
  LETTER_GRADE
  PASS_FAIL
  OTHER
}

enum ApplicationStatus {
  APPLIED
  INREVIEW
  WITHDRAWN
  HIRED
  REJECTED
}

enum ResumeParsingStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MatchStatus {
  CURRENT
  STALE
  PROCESSING
}

model User {
  id                          String          @id @default(cuid())
  email                       String          @unique
  password                    String
  otp                         String?
  otpExpiresAt                DateTime?
  resetPasswordToken          String?
  resetPasswordTokenExpiresAt DateTime?
  role                        UserRole
  status                      AccountStatus   @default(PENDING)
  isEmailVerified             Boolean         @default(false)
  lastLoginAt                 DateTime?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  deletedAt                   DateTime?
  deletedById                 String?
  deletedBy                   User?           @relation("DeletedBy", fields: [deletedById], references: [id])
  deletedUsers                User[]          @relation("DeletedBy")
  suspendedAt                 DateTime?
  suspendedById               String?
  suspendedBy                 User?           @relation("SuspendedBy", fields: [suspendedById], references: [id])
  suspendedUsers              User[]          @relation("SuspendedBy")
  suspendedReason             String?
  restoredAt                  DateTime?
  restoredById                String?
  restoredBy                  User?           @relation("RestoredBy", fields: [restoredById], references: [id])
  restoredUsers               User[]          @relation("RestoredBy")
  refreshTokens               RefreshToken[]
  candidate                   Candidate?
  employer                    Employer?
  admin                       Admin?
  companyMemberships          CompanyMember[]

  createdQuestions   Question[] @relation("QuestionCreatedBy")
  updatedQuestions   Question[] @relation("QuestionUpdatedBy")
  publishedQuestions Question[] @relation("QuestionPublishedBy")
  archivedQuestions  Question[] @relation("QuestionArchivedBy")
  deletedQuestions   Question[] @relation("QuestionDeletedBy")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Candidate {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName           String
  phoneNumber        String?
  profilePicture     String?
  headline           String?
  bio                String?
  dateOfBirth        DateTime?
  gender             Gender?
  experienceLevel    ExperienceLevel?
  currentLocation    String?
  preferredLocation  String?
  currentCompany     String?
  currentDesignation String?
  totalExperience    Float?
  expectedSalary     Int?
  currentSalary      Int?
  noticePeriod       Int?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  websiteUrl         String?
  isOpenToWork       Boolean                  @default(true)
  profileCompletion  Int                      @default(0)
  profileVersion     Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  skills             CandidateSkill[]
  educations         CandidateEducation[]
  experiences        CandidateExperience[]
  projects           CandidateProject[]
  certifications     CandidateCertification[]
  resumes            Resume[]
  applications       Application[]
  assessmentAttempts AssessmentAttempt[]
  savedJobs          SavedJob[]
  matches            CandidateJobMatch[]

  @@index([experienceLevel])
  @@index([currentLocation])
  @@index([isOpenToWork])
}

model Employer {
  id                   String                @id @default(cuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName             String
  phoneNumber          String?
  designation          String?
  department           String?
  profilePicture       String?
  linkedinUrl          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assignedApplications ApplicationWorkflow[]
  workflowHistories    WorkflowHistory[]
}

model Company {
  id                String            @id @default(cuid())
  companyName       String
  slug              String            @unique
  companyEmail      String?
  phoneNumber       String?
  website           String?
  logo              String?
  coverImage        String?
  description       String?
  industry          String?
  companySize       String?
  foundedYear       Int?
  headquarters      String?
  linkedinUrl       String?
  twitterUrl        String?
  status            CompanyStatus     @default(DRAFT)
  visibility        CompanyVisibility @default(PUBLIC)
  profileCompletion Int               @default(0)
  isVerified        Boolean           @default(false)
  verifiedAt        DateTime?
  verifiedBy        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  suspendedAt       DateTime?
  suspendedBy       String?
  suspendedReason   String?
  restoredAt        DateTime?
  restoredBy        String?
  jobs              Job[]
  companyMembers    CompanyMember[]
  workflows         Workflow[]
  stageLibraries    StageLibrary[]
  questions         Question[]
  assessments       Assessment[]
  interviews        Interview[]
}

model CompanyMember {
  id                  String              @id @default(cuid())
  userId              String
  companyId           String
  role                CompanyMemberRole
  joinedAt            DateTime            @default(now())
  status              CompanyMemberStatus @default(ACTIVE)
  invitationToken     String?             @unique
  invitedAt           DateTime?
  expiresAt           DateTime?
  invitedBy           String?
  user                User                @relation(fields: [userId], references: [id])
  company             Company             @relation(fields: [companyId], references: [id])
  jobMembers          JobMember[]
  questions           Question[]
  createdAssessments  Assessment[]        @relation("AssessmentCreatedBy")
  updatedAssessments  Assessment[]        @relation("AssessmentUpdatedBy")
  archivedAssessments Assessment[]        @relation("AssessmentArchivedBy")
  deletedAssessments  Assessment[]        @relation("AssessmentDeletedBy")

  createdInterviews            Interview[]                   @relation("InterviewCreatedBy")
  interviewAssignments         InterviewAssignment[]         @relation("InterviewAssignmentAssignedBy")
  interviewSessionParticipants InterviewSessionParticipant[]
  interviewEvaluations         InterviewEvaluation[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model Admin {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phoneNumber    String?
  profilePicture String?
  designation    String?
  department     String?
  employeeId     String?   @unique
  isSuperAdmin   Boolean   @default(false)
  isActive       Boolean   @default(true)
  lastActiveAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Job {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title String
  slug  String @unique

  summary     String?
  description String

  employmentType EmploymentType
  workplaceType  WorkplaceType

  status     JobStatus     @default(DRAFT)
  visibility JobVisibility @default(PUBLIC)

  vacancies Int @default(1)

  location String?

  minExperience Int @default(0)
  maxExperience Int @default(0)

  minimumSalary Int?
  maximumSalary Int?
  salaryPeriod  SalaryPeriod?
  hideSalary    Boolean       @default(false)

  applicationDeadline DateTime?

  publishedAt DateTime?
  closedAt    DateTime?
  archivedAt  DateTime?

  createdById String
  updatedById String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  requirementsVersion Int      @default(1)

  skills         JobSkill[]
  benefits       JobBenefit[]
  members        JobMember[]
  applications   Application[]
  savedJobs      SavedJob[]
  workflowId     String?
  workflow       Workflow?           @relation(fields: [workflowId], references: [id])
  jobAssessments JobAssessment[]
  jobInterviews  JobInterview[]
  matches        CandidateJobMatch[]

  @@index([companyId])
  @@index([status])
  @@index([employmentType])
  @@index([workplaceType])
  @@index([workflowId])
}

model SavedJob {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  savedAt     DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

model JobSkill {
  id String @id @default(cuid())

  name String

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  isRequired Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, name])
  @@index([jobId])
}

model JobBenefit {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  benefit String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, benefit])
  @@index([jobId])
}

model JobMember {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  assignedBy String?

  companyMemberId String
  companyMember   CompanyMember @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, companyMemberId])
  @@index([jobId])
  @@index([companyMemberId])
}

model Application {
  id String @id @default(cuid())

  candidateId String
  jobId       String

  status ApplicationStatus @default(APPLIED)

  coverLetter String?

  appliedAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lastStatusUpdatedAt DateTime?

  withdrawnAt    DateTime?
  withdrawReason String?

  rejectedAt      DateTime?
  rejectionReason String?

  hiredAt DateTime?

  candidate             Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job                   Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applicationResume     ApplicationResume?
  applicationWorkflow   ApplicationWorkflow?
  assessmentAttempts    AssessmentAttempt[]
  assessmentInvitations AssessmentInvitation[]
  interviewAssignments  InterviewAssignment[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([jobId, status])
}

model ApplicationResume {
  id String @id @default(cuid())

  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  sourceResumeId String?
  sourceResume   Resume? @relation("ResumeSnapshots", fields: [sourceResumeId], references: [id], onDelete: SetNull)

  fileName String
  fileUrl  String
  fileSize Int

  createdAt DateTime @default(now())

  @@index([sourceResumeId])
}

model Resume {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidateId String

  resumeName String
  resumeUrl  String
  fileSize   Int

  uploadedAt DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  deletedAt  DateTime?

  parsingStatus      ResumeParsingStatus @default(UPLOADED)
  parsingStartedAt   DateTime?
  parsingCompletedAt DateTime?
  parsingError       String?
  rawParsedData      Json?

  applicationSnapshots ApplicationResume[] @relation("ResumeSnapshots")

  @@index([candidateId])
  @@index([candidateId, deletedAt])
  @@index([parsingStatus])
}

model CandidateSkill {
  id                String    @id @default(cuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId           String?
  skill             Skill?    @relation(fields: [skillId], references: [id], onDelete: SetNull)
  name              String
  yearsOfExperience Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([candidateId, name])
  @@index([candidateId])
  @@index([skillId])
}

model CandidateEducation {
  id                String        @id @default(cuid())
  candidate         Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId       String
  collegeName       String
  degree            String
  fieldOfStudy      String
  currentlyStudying Boolean       @default(false)
  startDate         DateTime
  endDate           DateTime?
  gradingSystem     GradingSystem
  gradeText         String?
  grade             Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([candidateId])
}

model CandidateExperience {
  id               String         @id @default(cuid())
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId      String
  companyName      String
  designation      String
  employmentType   EmploymentType
  description      String?
  location         String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([candidateId])
  @@index([companyName])
}

model CandidateProject {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  fingerprint String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, fingerprint])
  @@index([candidateId])
}

model CandidateCertification {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name        String
  fingerprint String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, fingerprint])
  @@index([candidateId])
}

enum WorkflowStatus {
  ACTIVE
  INACTIVE
}

model Workflow {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isDefault   Boolean         @default(false)
  status      WorkflowStatus  @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  stages      WorkflowStage[]
  jobs        Job[]

  @@unique([companyId, name])
  @@index([companyId])
}

enum StageType {
  SYSTEM
  CUSTOM
}

model StageLibrary {
  id             String          @id @default(cuid())
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  type           StageType
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workflowStages WorkflowStage[]

  @@unique([companyId, name])
  @@index([companyId])
}

model WorkflowStage {
  id                    String                @id @default(cuid())
  workflowId            String
  workflow              Workflow              @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stageLibraryId        String
  stageLibrary          StageLibrary          @relation(fields: [stageLibraryId], references: [id], onDelete: Cascade)
  order                 Int
  isEnabled             Boolean               @default(true)
  isFinal               Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  applicationWorkflows  ApplicationWorkflow[]
  workflowHistoriesFrom WorkflowHistory[]     @relation("FromStage")
  workflowHistoriesTo   WorkflowHistory[]     @relation("ToStage")
  assessmentId          String?
  assessment            Assessment?           @relation(fields: [assessmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  interviewId           String?
  interview             Interview?            @relation(fields: [interviewId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([workflowId, order])
  @@unique([workflowId, stageLibraryId])
  @@index([workflowId])
  @@index([stageLibraryId])
  @@index([assessmentId])
  @@index([interviewId])
}

model ApplicationWorkflow {
  id                 String            @id @default(cuid())
  applicationId      String            @unique
  application        Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  workflowStageId    String
  workflowStage      WorkflowStage     @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)
  assignedEmployerId String?
  assignedEmployer   Employer?         @relation(fields: [assignedEmployerId], references: [id])
  remarks            String?
  movedAt            DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workflowHistories  WorkflowHistory[]

  @@index([workflowStageId])
  @@index([assignedEmployerId])
}

model WorkflowHistory {
  id                    String              @id @default(cuid())
  applicationWorkflowId String
  applicationWorkflow   ApplicationWorkflow @relation(fields: [applicationWorkflowId], references: [id], onDelete: Cascade)
  fromStageId           String?
  fromStage             WorkflowStage?      @relation("FromStage", fields: [fromStageId], references: [id])
  toStageId             String
  toStage               WorkflowStage       @relation("ToStage", fields: [toStageId], references: [id])
  movedByEmployerId     String?
  movedBy               Employer?           @relation(fields: [movedByEmployerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  comment               String?
  createdAt             DateTime            @default(now())

  @@index([applicationWorkflowId])
  @@index([fromStageId])
  @@index([toStageId])
  @@index([movedByEmployerId])
}

enum QuestionType {
  MCQ
  DSA
  MACHINE_CODING
  PROJECT
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionOwnership {
  GLOBAL
  COMPANY
}

enum TestCaseType {
  SAMPLE
  HIDDEN
}

model QuestionCategory {
  id           String             @id @default(cuid())
  name         String
  displayOrder Int                @default(0)
  parentId     String?
  parent       QuestionCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     QuestionCategory[] @relation("CategoryHierarchy")
  questions    Question[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  @@unique([parentId, name])
  @@index([parentId])
  @@index([deletedAt])
}

model QuestionTag {
  id           String           @id @default(cuid())
  name         String           @unique
  questionTags QuestionTagMap[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model QuestionTagMap {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  tagId String
  tag   QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([questionId, tagId])
  @@index([questionId])
  @@index([tagId])
}

model Question {
  id          String @id @default(cuid())
  title       String
  description String

  type       QuestionType
  difficulty QuestionDifficulty

  estimatedTime Int
  defaultMarks  Float

  ownership QuestionOwnership
  status    QuestionStatus    @default(DRAFT)

  code String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdByCompanyMemberId String?
  createdByCompanyMember   CompanyMember? @relation(fields: [createdByCompanyMemberId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdById String?
  createdBy   User?   @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  updatedById String?
  updatedBy   User?   @relation("QuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  publishedById String?
  publishedBy   User?   @relation("QuestionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  archivedById String?
  archivedBy   User?   @relation("QuestionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  deletedAt DateTime?

  deletedById String?
  deletedBy   User?   @relation("QuestionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  categoryId String?
  category   QuestionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  publishedAt DateTime?
  archivedAt  DateTime?

  version     Int    @default(1)
  usageCount  Int    @default(0)
  successRate Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags QuestionTagMap[]

  mcqDetail           MCQDetail?
  dsaDetail           DSADetail?
  machineCodingDetail MachineCodingDetail?
  projectDetail       ProjectDetail?
  sectionItems        AssessmentSectionItem[]
  answers             AssessmentAnswer[]

  @@index([companyId])
  @@index([createdByCompanyMemberId])
  @@index([createdById])
  @@index([companyId, status])
  @@index([companyId, type])
  @@index([status, type])
  @@index([companyId, categoryId])
  @@index([deletedAt])
  @@index([ownership, companyId])
  @@index([status, difficulty])
}

model MCQDetail {
  id String @id @default(cuid())

  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  allowMultipleCorrectAnswers Boolean @default(false)
  negativeMarks               Float   @default(0.0)

  options MCQOption[]
}

model MCQOption {
  id String @id @default(cuid())

  mcqDetailId String
  mcqDetail   MCQDetail @relation(fields: [mcqDetailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  optionText   String
  displayOrder Int

  isCorrect Boolean @default(false)

  @@unique([mcqDetailId, displayOrder])
  @@index([mcqDetailId])
}

model DSADetail {
  id String @id @default(cuid())

  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  starterCode       String
  referenceSolution String

  memoryLimit Int
  timeLimit   Int

  supportedLanguages DSASupportedLanguage[]
  testCases          TestCase[]
}

model ProgrammingLanguage {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  isActive Boolean @default(true)

  supportedLanguages DSASupportedLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model DSASupportedLanguage {
  dsaDetailId String
  dsaDetail   DSADetail @relation(fields: [dsaDetailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  programmingLanguageId String
  programmingLanguage   ProgrammingLanguage @relation(fields: [programmingLanguageId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@id([dsaDetailId, programmingLanguageId])
  @@index([dsaDetailId])
  @@index([programmingLanguageId])
}

model TestCase {
  id String @id @default(cuid())

  dsaDetailId String
  dsaDetail   DSADetail @relation(fields: [dsaDetailId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  input          String
  expectedOutput String

  type TestCaseType @default(SAMPLE)

  explanation  String?
  displayOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dsaDetailId, displayOrder]) // finalized version
  @@index([dsaDetailId])
  @@index([dsaDetailId, type])
}

model MachineCodingDetail {
  id String @id @default(cuid())

  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  repositoryTemplate         String?
  projectStructure           String?
  techStack                  String?
  implementationInstructions String
  evaluationGuidelines       String?
}

model ProjectDetail {
  id String @id @default(cuid())

  questionId String   @unique
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  requirements           String
  submissionInstructions String
  deadlineHours          Int
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum EvaluationStatus {
  PENDING
  EVALUATING
  COMPLETED
  FAILED
}

enum ReviewStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model Assessment {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title           String
  description     String?
  instructions    String?
  durationMinutes Int?
  passingScore    Float?
  status          AssessmentStatus @default(DRAFT)
  totalMarks      Float?
  isTemplate      Boolean          @default(false)

  // Audit Fields
  createdById  String
  createdBy    CompanyMember  @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  updatedById  String?
  updatedBy    CompanyMember? @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  archivedById String?
  archivedBy   CompanyMember? @relation("AssessmentArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deletedById  String?
  deletedBy    CompanyMember? @relation("AssessmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  publishedAt  DateTime?
  archivedAt   DateTime?

  // Relations
  sections              AssessmentSection[]
  attempts              AssessmentAttempt[]
  jobs                  JobAssessment[]
  workflowStages        WorkflowStage[]
  assessmentInvitations AssessmentInvitation[]

  @@index([companyId])
  @@index([status])
  @@index([deletedAt])
}

model AssessmentSection {
  id              String                  @id @default(cuid())
  assessmentId    String
  assessment      Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title           String
  description     String?
  instructions    String?
  durationMinutes Int?
  displayOrder    Int
  sectionType     QuestionType
  // Relations
  items           AssessmentSectionItem[]
  attempts        AssessmentAttempt[]

  @@unique([assessmentId, displayOrder])
  @@index([assessmentId])
}

model AssessmentSectionItem {
  id                    String            @id @default(cuid())
  sectionId             String
  section               AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId            String
  question              Question          @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  displayOrder          Int
  marksOverride         Float?
  negativeMarksOverride Float?
  timeLimitOverride     Int?
  isRequired            Boolean           @default(true)

  @@unique([sectionId, displayOrder])
  @@index([sectionId])
  @@index([questionId])
}

model AssessmentAttempt {
  id               String             @id @default(cuid())
  candidateId      String
  candidate        Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applicationId    String
  application      Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessmentId     String
  assessment       Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currentSectionId String?
  currentSection   AssessmentSection? @relation(fields: [currentSectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Status & Telemetry
  status                   AttemptStatus @default(NOT_STARTED)
  startedAt                DateTime?
  submittedAt              DateTime?
  lastActivityAt           DateTime?
  attemptNumber            Int           @default(1)
  timeTakenInSeconds       Int?
  completedDurationSeconds Int?

  // Evaluation & Review
  overallScore     Float?
  percentage       Float?
  passed           Boolean?
  evaluationStatus EvaluationStatus @default(PENDING)
  reviewStatus     ReviewStatus     @default(PENDING)

  // Relations
  answers   AssessmentAnswer[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([candidateId])
  @@index([applicationId])
  @@index([assessmentId])
  @@index([status])
}

model AssessmentAnswer {
  id          String            @id @default(cuid())
  attemptId   String
  attempt     AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  questionId  String
  question    Question          @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  startedAt   DateTime?
  updatedAt   DateTime          @updatedAt
  submittedAt DateTime?
  // Score & Evaluation
  score       Float?
  isCorrect   Boolean?
  feedback    String?

  // Generic Submissions Data
  selectedOptionIds String[]
  attachmentUrls    String[]
  codeResponse      String?
  submissionUrl     String?
  meta              Json?

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model JobAssessment {
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  displayOrder Int
  isMandatory  Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@id([jobId, assessmentId])
  @@index([jobId])
  @@index([assessmentId])
}

enum InvitationStatus {
  PENDING
  CANCELLED
  EXPIRED
  SUBMITTED
}

model AssessmentInvitation {
  id             String           @id @default(cuid())
  applicationId  String
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessmentId   String
  assessment     Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  idempotencyKey String?          @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([applicationId])
  @@index([assessmentId])
}

// ==========================================
// INTERVIEW MODULE
// ==========================================

enum InterviewType {
  AI
  NORMAL
}

enum InterviewMode {
  INDIVIDUAL
  GROUP
}

enum InterviewStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InterviewSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum InterviewAssignmentCreationSource {
  AUTOMATIC
  MANUAL
}

enum InterviewParticipantType {
  CANDIDATE
  INTERVIEWER
}

model Interview {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   CompanyMember @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  title           String
  description     String?
  instructions    String?
  type            InterviewType
  mode            InterviewMode
  status          InterviewStatus @default(DRAFT)
  durationMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobInterviews   JobInterview[]
  sessions        InterviewSession[]
  assignments     InterviewAssignment[]
  workflowStages  WorkflowStage[]
  aiConfiguration AIInterviewConfiguration?

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model JobInterview {
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviewId  String
  interview    Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  displayOrder Int       @default(0)
  isMandatory  Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@id([jobId, interviewId])
  @@index([jobId])
  @@index([interviewId])
}

model InterviewAssignment {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  creationSource InterviewAssignmentCreationSource

  assignedById String?
  assignedBy   CompanyMember? @relation("InterviewAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionParticipants InterviewSessionParticipant[]

  @@unique([interviewId, applicationId])
  @@index([interviewId])
  @@index([applicationId])
  @@index([assignedById])
}

model InterviewSession {
  id          String    @id @default(cuid())
  interviewId String
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  status InterviewSessionStatus @default(SCHEDULED)

  scheduledAt DateTime
  startedAt   DateTime?
  endedAt     DateTime?

  roomId String? // For normal live sessions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants InterviewSessionParticipant[]
  aiQuestions  AIInterviewQuestion[]
  aiResult     AIInterviewResult?
  evaluations  InterviewEvaluation[]

  @@index([interviewId])
  @@index([status])
  @@index([scheduledAt])
}

model InterviewEvaluation {
  id                  String            @id @default(cuid())
  sessionId           String
  session             InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyMemberId     String
  companyMember       CompanyMember     @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)
  overallScore        Float
  communicationScore  Float?
  technicalScore      Float?
  problemSolvingScore Float?
  behaviourScore      Float?
  cultureFitScore     Float?
  strengths           Json?
  improvements        Json?
  comments            String?
  recommendation      AIRecommendation?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([sessionId, companyMemberId])
  @@index([sessionId])
  @@index([companyMemberId])
}

model InterviewSessionParticipant {
  id              String                   @id @default(cuid())
  sessionId       String
  session         InterviewSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantType InterviewParticipantType

  assignmentId String?
  assignment   InterviewAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  companyMemberId String?
  companyMember   CompanyMember? @relation(fields: [companyMemberId], references: [id], onDelete: Cascade)

  hasJoined Boolean   @default(false)
  joinedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, assignmentId])
  @@unique([sessionId, companyMemberId])
  @@index([sessionId])
  @@index([assignmentId])
  @@index([companyMemberId])
}

model AIInterviewConfiguration {
  id          String    @id @default(cuid())
  interviewId String    @unique
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  systemPrompt      String?
  evaluationMetrics Json?
  questionCount     Int                @default(5)
  difficulty        QuestionDifficulty @default(MEDIUM)
  allowFollowUps    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AIRecommendation {
  STRONG_HIRE
  HIRE
  HOLD
  REJECT
  STRONG_REJECT
}

model AIInterviewQuestion {
  id                 String                @id @default(cuid())
  sessionId          String
  session            InterviewSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sequence           Int
  question           String
  topic              String?
  skill              String?
  difficulty         QuestionDifficulty?
  expectedAreas      Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  answer             AIInterviewAnswer?
  parentAIQuestionId String?
  parentQuestion     AIInterviewQuestion?  @relation("QuestionFollowUps", fields: [parentAIQuestionId], references: [id], onDelete: SetNull)
  followUpQuestions  AIInterviewQuestion[] @relation("QuestionFollowUps")

  @@unique([sessionId, sequence])
  @@index([parentAIQuestionId])
}

model AIInterviewAnswer {
  id           String                 @id @default(cuid())
  questionId   String                 @unique
  question     AIInterviewQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText   String
  recordingUrl String?
  answeredAt   DateTime               @default(now())
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  evaluation   AIInterviewEvaluation?
}

model AIInterviewEvaluation {
  id                String            @id @default(cuid())
  answerId          String            @unique
  answer            AIInterviewAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  score             Float
  technicalAccuracy Float?
  relevance         Float?
  completeness      Float?
  communication     Float?
  feedback          String?
  strengths         Json?
  weaknesses        Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model AIInterviewResult {
  id                  String            @id @default(cuid())
  sessionId           String            @unique
  session             InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore        Float
  technicalScore      Float?
  communicationScore  Float?
  problemSolvingScore Float?
  overallFeedback     String?
  strengths           Json?
  weaknesses          Json?
  recommendation      AIRecommendation?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

enum SkillCategory {
  PROGRAMMING_LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  CLOUD
  MOBILE
  AI_ML
  TESTING
  TOOLS
  SOFT_SKILL
  OTHER
}

enum SkillCandidateStatus {
  PENDING
  APPROVED
  REJECTED
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  category    SkillCategory @default(OTHER)
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  aliases         SkillAlias[]
  candidateSkills CandidateSkill[]

  @@index([category])
  @@index([isActive])
}

model SkillAlias {
  id              String   @id @default(cuid())
  skillId         String
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([skillId])
  @@index([normalizedAlias])
}

model SkillCandidate {
  id              String               @id @default(cuid())
  rawName         String
  normalizedName  String               @unique
  occurrenceCount Int                  @default(1)
  status          SkillCandidateStatus @default(PENDING)
  firstSeenAt     DateTime             @default(now())
  lastSeenAt      DateTime             @updatedAt

  @@index([status])
  @@index([normalizedName])
}

model CandidateJobMatch {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  matchScore         Float
  deterministicScore Float
  semanticScore      Float?

  matchingFactors Json
  status          MatchStatus @default(CURRENT)

  candidateVersion Int @default(1)
  jobVersion       Int @default(1)

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId, matchScore(sort: Desc)])
  @@index([jobId, matchScore(sort: Desc)])
  @@index([candidateId, status])
  @@index([jobId, status])
}
